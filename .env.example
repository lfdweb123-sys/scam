# --- Firebase Admin (Firestore) ---
# Récupérés depuis : Console Firebase > Paramètres du projet > Comptes de service > Générer une clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la clé complète ; dans Vercel, gardez les \n échappés tels quels
FIREBASE_PRIVATE_KEY=

# --- Anthropic (modération automatique) ---
ANTHROPIC_API_KEY=

# --- Brevo (notification email à chaque signalement) ---
BREVO_API_KEY=
NOTIFICATION_EMAIL=
NOTIFICATION_SENDER_EMAIL=notifications@votredomaine.com

# --- Anti-abus ---
# Chaîne aléatoire utilisée pour hasher les IP (ne jamais réutiliser une valeur publique)
RATE_LIMIT_SALT=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://votredomaine.com
